{
  "schema_version": 1,
  "purpose": "Shared Python/Rust agreement cases for strategy village scout capacity (proposed-movement Stack 1). Frozen before implementation; do not edit in a worker.",
  "semantics": {
    "required_assignments": "distinct listed villages that are not completed, not owned by the controlled side (all listed villages when ownership is unknown), and not currently in scout_assignments",
    "scout_capacity": "effective live eligible scouts (policy.scouts plus progress.scout_ids; not held, not recruiter) that have no scout assignment, plus remaining scout-role recruits (count minus recruited done for that queue index); a moved scout still counts",
    "ok": "required_assignments <= scout_capacity",
    "fresh": "progress null means a fresh installation: no assignments, completions or recruits",
    "rust_cause": "fresh installation -> insufficient_scout_capacity; any committed progress -> scout_capacity_exhausted (runtime evidence, no claim about original impossibility)"
  },
